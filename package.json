{
  "name": "local-site-boilerplate",
  "version": "1.2.0",
  "description": "Astro boilerplate for local home-service websites. Built for SEO, GEO, and AEO, and ready to deploy on Cloudflare Workers.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "verify": "astro build && ./scripts/run-all.sh",
    "validate:client": "node --test scripts/client-data.test.mjs && node scripts/validate-client.mjs",
    "client:generate": "node scripts/client-generate.mjs",
    "scaffold": "node scripts/scaffold.mjs",
    "doctor": "node scripts/doctor.mjs",
    "evaluate:content": "node scripts/quality/evaluate-content.mjs",
    "evaluate:conversion": "node scripts/quality/evaluate-conversion.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.3",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.0",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "impeccable": "4.8.0",
    "js-yaml": "5.5.0",
    "typescript": "5.9.3",
    "wrangler": "4.156.0"
  }
}
