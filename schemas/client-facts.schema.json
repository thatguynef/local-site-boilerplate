{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thatguynef/local-site-boilerplate/schemas/client-facts.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["business", "contact", "address", "geo", "hours", "hours_display", "locale", "lang", "service_area", "services", "profiles", "analytics", "claims"],
  "properties": {
    "business": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schema_type", "trade", "primary_service"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "legal_name": { "type": "string" },
        "schema_type": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "trade": { "type": "string", "minLength": 2 },
        "primary_service": { "type": "string", "minLength": 2 }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phone_display", "phone_tel", "email"],
      "properties": {
        "phone_display": { "type": "string", "minLength": 7 },
        "phone_tel": { "type": "string", "pattern": "^\\+[1-9][0-9]{7,14}$" },
        "email": { "type": "string", "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$" }
      }
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["street", "city", "region", "postal_code", "country"],
      "properties": {
        "street": { "type": "string", "minLength": 2 },
        "city": { "type": "string", "minLength": 2 },
        "region": { "type": "string", "minLength": 2, "maxLength": 40 },
        "postal_code": { "type": "string", "minLength": 3, "maxLength": 12 },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    },
    "geo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "hours": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/hours" }
    },
    "hours_display": { "type": "string", "minLength": 3 },
    "locale": { "type": "string", "pattern": "^[a-z]{2}_[A-Z]{2}$" },
    "lang": { "type": "string", "pattern": "^[a-z]{2}$" },
    "service_area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "primary_city", "cities", "neighborhoods"],
      "properties": {
        "summary": { "type": "string", "minLength": 3 },
        "primary_city": { "type": "string", "minLength": 2 },
        "cities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/city" }
        },
        "neighborhoods": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary"],
      "properties": {
        "primary": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/service" }
        },
        "offered": {
          "type": "array",
          "items": { "$ref": "#/$defs/service" }
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "google_business_profile": { "$ref": "#/$defs/url" },
        "facebook": { "$ref": "#/$defs/url" },
        "yelp": { "$ref": "#/$defs/url" }
      }
    },
    "analytics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ga4", "gtm"],
      "properties": {
        "ga4": { "type": "string", "pattern": "^$|^G-[A-Z0-9]+$" },
        "gtm": { "type": "string", "pattern": "^$|^GTM-[A-Z0-9]+$" }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license",
        "insurance",
        "guarantee",
        "emergency_service",
        "same_day_service",
        "response_time",
        "financing",
        "starting_price",
        "owner_name",
        "years_in_business",
        "reviews_rating",
        "reviews_count",
        "awards",
        "certifications",
        "after_hours",
        "maintenance_plan"
      ],
      "properties": {
        "license": { "$ref": "#/$defs/claim" },
        "insurance": { "$ref": "#/$defs/claim" },
        "guarantee": { "$ref": "#/$defs/claim" },
        "emergency_service": { "$ref": "#/$defs/claim" },
        "same_day_service": { "$ref": "#/$defs/claim" },
        "response_time": { "$ref": "#/$defs/claim" },
        "financing": { "$ref": "#/$defs/claim" },
        "starting_price": { "$ref": "#/$defs/claim" },
        "owner_name": { "$ref": "#/$defs/claim" },
        "years_in_business": { "$ref": "#/$defs/claim" },
        "reviews_rating": { "$ref": "#/$defs/claim" },
        "reviews_count": { "$ref": "#/$defs/claim" },
        "awards": { "$ref": "#/$defs/claim" },
        "certifications": { "$ref": "#/$defs/claim" },
        "after_hours": { "$ref": "#/$defs/claim" },
        "maintenance_plan": { "$ref": "#/$defs/claim" }
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status"],
      "properties": {
        "value": { "type": ["string", "boolean", "number"] },
        "status": {
          "enum": [
            "verified_public",
            "client_supplied",
            "client_confirmed",
            "inferred_nonpublishable",
            "unknown",
            "conflicting",
            "expired"
          ]
        },
        "source": { "type": "string" }
      }
    },
    "hours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days", "opens", "closes"],
      "properties": {
        "days": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
          }
        },
        "opens": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "closes": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
      }
    },
    "city": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
      }
    },
    "url": { "type": "string", "pattern": "^$|^https://\\S+$" }
  }
}
