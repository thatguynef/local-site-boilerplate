{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thatguynef/local-site-boilerplate/schemas/client-strategy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["audience", "customer_situations", "positioning", "conversion"],
  "properties": {
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary"],
      "properties": {
        "primary": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        }
      }
    },
    "customer_situations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["urgent", "considered"],
      "properties": {
        "urgent": { "type": "array", "items": { "type": "string", "minLength": 2 } },
        "considered": { "type": "array", "items": { "type": "string", "minLength": 2 } }
      }
    },
    "positioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "desired_perception", "differentiators", "avoid_positioning"],
      "properties": {
        "core": { "type": "string", "minLength": 10 },
        "desired_perception": { "type": "array", "items": { "type": "string", "minLength": 2 } },
        "differentiators": { "type": "array", "items": { "type": "string", "minLength": 2 } },
        "avoid_positioning": { "type": "array", "items": { "type": "string", "minLength": 2 } }
      }
    },
    "conversion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "mobile", "emergency", "response_expectation"],
      "properties": {
        "primary": { "$ref": "#/$defs/cta" },
        "secondary": { "$ref": "#/$defs/cta" },
        "mobile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sticky_action"],
          "properties": {
            "sticky_action": { "$ref": "#/$defs/ctaType" }
          }
        },
        "emergency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prioritize_phone"],
          "properties": {
            "prioritize_phone": { "type": "boolean" }
          }
        },
        "response_expectation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "research": { "$ref": "#/$defs/research" }
  },
  "$defs": {
    "ctaType": {
      "enum": [
        "phone",
        "request_service",
        "request_quote",
        "request_estimate",
        "book_consultation",
        "book_inspection",
        "schedule_service",
        "directions"
      ]
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label"],
      "properties": {
        "type": { "$ref": "#/$defs/ctaType" },
        "label": { "type": "string", "minLength": 2 }
      }
    },
    "note": {
      "type": "string",
      "minLength": 2,
      "maxLength": 240
    },
    "noteList": {
      "type": "array",
      "items": { "$ref": "#/$defs/note" }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conventions",
        "gaps",
        "trust_requirements",
        "customer_fears",
        "high_intent_services",
        "common_offers",
        "conversion_patterns",
        "content_opportunities"
      ],
      "properties": {
        "conventions": { "$ref": "#/$defs/noteList" },
        "gaps": { "$ref": "#/$defs/noteList" },
        "trust_requirements": { "$ref": "#/$defs/noteList" },
        "customer_fears": { "$ref": "#/$defs/noteList" },
        "high_intent_services": { "$ref": "#/$defs/noteList" },
        "common_offers": { "$ref": "#/$defs/noteList" },
        "conversion_patterns": { "$ref": "#/$defs/noteList" },
        "content_opportunities": { "$ref": "#/$defs/noteList" },
        "differentiation": { "$ref": "#/$defs/noteList" },
        "intent_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["query", "intent", "home"],
            "properties": {
              "query": { "$ref": "#/$defs/note" },
              "intent": {
                "enum": ["hire", "compare", "price", "symptom", "informational", "navigational"]
              },
              "home": {
                "enum": ["service_page", "city_page", "faq", "existing_page", "do_not_build"]
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "note"],
            "properties": {
              "url": { "type": "string", "pattern": "^https://\\S+$" },
              "note": { "$ref": "#/$defs/note" }
            }
          }
        }
      }
    }
  }
}
