{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thatguynef/local-site-boilerplate/schemas/page-briefs.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "pages"],
  "properties": {
    "version": { "const": 1 },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/brief" }
    }
  },
  "$defs": {
    "ctaType": {
      "enum": [
        "phone",
        "request_service",
        "request_quote",
        "request_estimate",
        "book_consultation",
        "book_inspection",
        "schedule_service",
        "directions"
      ]
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label"],
      "properties": {
        "type": { "$ref": "#/$defs/ctaType" },
        "label": { "type": "string", "minLength": 2 }
      }
    },
    "line": {
      "type": "string",
      "minLength": 2,
      "maxLength": 240
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "slug",
        "search_intent",
        "visitor_situation",
        "primary_answer",
        "primary_cta",
        "supporting_proof",
        "objections",
        "questions",
        "related",
        "internal_links",
        "avoid"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/(services|service-areas)/[a-z0-9]+(?:-[a-z0-9]+)*/$"
        },
        "kind": { "enum": ["service", "service_area"] },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "search_intent": { "type": "string", "minLength": 8, "maxLength": 200 },
        "visitor_situation": { "type": "string", "minLength": 8, "maxLength": 400 },
        "primary_answer": { "type": "string", "minLength": 20, "maxLength": 500 },
        "primary_cta": { "$ref": "#/$defs/cta" },
        "supporting_proof": { "type": "array", "items": { "$ref": "#/$defs/line" } },
        "objections": { "type": "array", "items": { "$ref": "#/$defs/line" } },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 8, "maxLength": 200 }
        },
        "related": { "type": "array", "items": { "$ref": "#/$defs/line" } },
        "internal_links": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^/[a-z0-9][a-z0-9-/]*$" }
        },
        "avoid": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/line" }
        }
      }
    }
  }
}
