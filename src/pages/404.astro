---
import Base from '../layouts/Base.astro';
import { business } from '../config/business';

export const prerender = true;

const title = 'Page not found';
const description = 'That page is not on the Example Plumbing site. Go back home or call (555) 010-0199.';
---

<Base title={title} description={description} noindex>
  <article class="wrap">
    <header class="page-header">
      <h1>{title}</h1>
      <p>That page is not on this site. You can go back to the home page or call {business.businessName}.</p>
    </header>
    <p class="actions">
      <a class="button" href="/">Back to the home page</a>
      <a class="button button-secondary" href={`tel:${business.phoneTel}`}>Call {business.phoneDisplay}</a>
    </p>
  </article>
</Base>
