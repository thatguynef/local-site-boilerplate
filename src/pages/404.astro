---
import Base from '../layouts/Base.astro';
import Cluster from '../components/primitives/Cluster.astro';
import ContactAction from '../components/primitives/ContactAction.astro';
import Container from '../components/primitives/Container.astro';
import { business } from '../config/business';

export const prerender = true;

const title = 'Page not found';
const description = `That page is not on the ${business.businessName} site. Go back home or call ${business.phoneDisplay}.`;
---

<Base title={title} description={description} noindex>
  <Container as="article">
    <header class="page-header">
      <h1>{title}</h1>
      <p>That page is not on this site. You can go back to the home page or call {business.businessName}.</p>
    </header>
    <Cluster as="p" class="actions" gap="0.75rem">
      <ContactAction href="/">Back to the home page</ContactAction>
      <ContactAction href={`tel:${business.phoneTel}`} tone="secondary">Call {business.phoneDisplay}</ContactAction>
    </Cluster>
  </Container>
</Base>
