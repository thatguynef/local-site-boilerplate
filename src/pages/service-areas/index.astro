---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import CardLink from '../../components/primitives/CardLink.astro';
import Grid from '../../components/primitives/Grid.astro';
import { business } from '../../config/business';

export const prerender = true;

const areas = await getCollection('serviceAreas');
const tradeLabel = business.trade.charAt(0).toUpperCase() + business.trade.slice(1);
const places = business.neighborhoods.join(', ');
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Service areas', href: '/service-areas/' },
];
---

<Page
  title={`${tradeLabel} service areas in ${business.address.city}`}
  seoTitle={`${tradeLabel} service areas in ${business.address.city}`}
  description={`${business.businessName} serves ${business.address.city}, including ${places}.`}
  answer={`${business.businessName} serves homes in ${business.address.city}. The area includes ${places}. Add one page for each city you actually drive to.`}
  crumbs={crumbs}
>
  <Grid as="ul" class="card-list">
    {areas.map((area) => (
      <CardLink
        title={area.data.city}
        text={area.data.neighborhoods.join(', ')}
        href={`/service-areas/${area.id}/`}
        label={`${tradeLabel} in ${area.data.city}`}
      />
    ))}
  </Grid>
</Page>
