---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { business } from '../../config/business';

export const prerender = true;

const services = await getCollection('services');
const tradeLabel = business.trade.charAt(0).toUpperCase() + business.trade.slice(1);
const serviceList = business.primaryServices.map((service) => service.name.toLowerCase()).join(', ');
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
];
---

<Page
  title={`${tradeLabel} services in ${business.address.city}`}
  seoTitle={`${tradeLabel} services in ${business.address.city}`}
  description={`${business.businessName} offers ${serviceList} for homes in ${business.address.city}.`}
  answer={`${business.businessName} works on ${serviceList} for homes in ${business.address.city}. ${business.primaryService} is written up below. The other services start with a call until you add their pages.`}
  crumbs={crumbs}
  showArea
>
  <ul class="card-list">
    {business.primaryServices.map((service) => {
      const page = services.find((entry) => entry.data.title.toLowerCase().includes(service.name.toLowerCase()));
      const href = page ? `/services/${page.id}/` : service.href;
      return (
        <li class="card">
          <h2>{service.name}</h2>
          <p>{service.name} for homes in {business.address.city}.</p>
          <a href={href}>{page ? `Read about ${service.name}` : `Request ${service.name}`}</a>
        </li>
      );
    })}
  </ul>
</Page>
