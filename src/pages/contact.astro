---
import Base from '../layouts/Base.astro';
import Answer from '../components/Answer.astro';
import ContactForm from '../components/ContactForm.astro';
import Trust from '../components/Trust.astro';
import { business } from '../config/business';

export const prerender = true;

const citySlug = business.address.city
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '');
const title = `Contact ${business.businessName}`;
const description = `Call ${business.businessName} at ${business.phoneDisplay} or request a call back for homes in ${business.address.city}. ${business.responsePromise}`;
const answer = `Call ${business.phoneDisplay} or send the form. ${business.responsePromise} Homes in ${business.address.city}.`;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: '/contact/' },
];
---

<Base title={title} seoTitle={`Contact ${business.businessName} in ${business.address.city}`} description={description} crumbs={crumbs}>
  <article class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li>Contact</li>
      </ol>
    </nav>
    <header class="page-header">
      <h1>{title}</h1>
      <Answer text={answer} />
    </header>
    <p>{business.responsePromise} Hours: {business.hoursDisplay}.</p>
    {business.afterHours.trim() && <p data-after-hours>{business.afterHours}</p>}
    <ContactForm />
    <section class="section">
      <h2>Where is {business.businessName}?</h2>
      <p>
        {business.businessName}<br />
        {business.address.street}<br />
        {business.address.city}, {business.address.region} {business.address.postalCode}<br />
        <a href={`tel:${business.phoneTel}`}>{business.phoneDisplay}</a>
      </p>
      <p>Service questions start on the <a href="/services/">services page</a> and the <a href={`/service-areas/${citySlug}/`}>{business.address.city} page</a>.</p>
    </section>
    <Trust />
  </article>
</Base>
