---
import Base from '../layouts/Base.astro';
import Answer from '../components/Answer.astro';
import ContactForm from '../components/ContactForm.astro';
import Trust from '../components/Trust.astro';
import { business } from '../config/business';

export const prerender = true;

const title = 'Contact Example Plumbing';
const description = 'Call Example Plumbing at (555) 010-0199 or request a call back within one business hour for homes in Example City.';
const answer = 'Call (555) 010-0199 or send the form. Example Plumbing calls back within one business hour, 7:00 a.m. to 7:00 p.m., for homes in Example City.';
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: '/contact/' },
];
---

<Base title={title} seoTitle="Contact a Plumber in Example City" description={description} crumbs={crumbs}>
  <article class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li>Contact</li>
      </ol>
    </nav>
    <header class="page-header">
      <h1>{title}</h1>
      <Answer text={answer} />
    </header>
    <p>{business.responsePromise} Hours: {business.hoursDisplay}.</p>
    <ContactForm />
    <section class="section">
      <h2>Where is Example Plumbing?</h2>
      <p>
        {business.businessName}<br />
        {business.address.street}<br />
        {business.address.city}, {business.address.region} {business.address.postalCode}<br />
        <a href={`tel:${business.phoneTel}`}>{business.phoneDisplay}</a>
      </p>
      <p>Service questions start on the <a href="/services/">services page</a> and the <a href="/service-areas/example-city/">Example City page</a>.</p>
    </section>
    <Trust />
  </article>
</Base>
