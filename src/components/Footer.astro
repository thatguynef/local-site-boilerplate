---
import { business } from '../config/business';
import Cluster from './primitives/Cluster.astro';
import Container from './primitives/Container.astro';
import Split from './primitives/Split.astro';

const year = new Date().getFullYear();
const { address } = business;
---

<footer class="site-footer">
  <Split class="wrap footer-grid" gap="1.25rem" columns="1.2fr 1fr">
    <address class="nap" data-nap>
      <span data-name>{business.businessName}</span>
      <span data-street>{address.street}</span>
      <span>
        <span data-city>{address.city}</span>, <span data-region>{address.region}</span> <span data-postal>{address.postalCode}</span>
      </span>
      <a data-phone href={`tel:${business.phoneTel}`}>{business.phoneDisplay}</a>
      <a href={`mailto:${business.email}`}>{business.email}</a>
      <span data-hours>{business.hoursDisplay}</span>
      {business.afterHours.trim() && <span data-after-hours>{business.afterHours}</span>}
    </address>
    <nav class="footer-nav" aria-label="Footer">
      <Cluster as="ul" gap="0.15rem 0.25rem">
        {business.footerNav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </Cluster>
    </nav>
  </Split>
  <Container as="p" class="legal">© {year} {business.businessName}</Container>
</footer>
