---
import { business } from '../config/business';
import Callout from './primitives/Callout.astro';
import Cluster from './primitives/Cluster.astro';
import ContactAction from './primitives/ContactAction.astro';

const path = Astro.url.pathname;
---

{business.showExampleBanner && (
  <Callout class="banner">Example content. Replace the business details in src/config/business.ts before launch.</Callout>
)}
<header class="site-header">
  <Cluster class="wrap header-inner" gap="0.5rem 1.25rem">
    <a class="brand" href="/">{business.businessName}</a>
    <nav class="nav" aria-label="Main">
      <Cluster as="ul" gap="0.15rem 0.25rem">
        {business.mainNav.map((item) => {
          const current = item.href === '/' ? path === '/' : path.startsWith(item.href);
          return (
            <li>
              <a href={item.href} aria-current={current ? 'page' : undefined}>{item.label}</a>
            </li>
          );
        })}
      </Cluster>
    </nav>
    <ContactAction href={`tel:${business.phoneTel}`} tone="header">{business.phoneDisplay}</ContactAction>
  </Cluster>
</header>
