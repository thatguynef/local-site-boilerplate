---
import { business } from '../config/business';

interface Props {
  city?: string;
  neighborhoods?: string[];
}
const city = Astro.props.city || business.address.city;
const neighborhoods = Astro.props.neighborhoods || business.neighborhoods;
---

<section class="section" data-service-area>
  <h2>Which {city} neighborhoods are served?</h2>
  <p>
    {business.businessName} works in {city}. The service area is {business.serviceArea}. Neighborhoods on this page: {neighborhoods.join(', ')}.
  </p>
</section>
