---
import { business } from '../config/business';

interface Props {
  title: string;
  description: string;
  seoTitle?: string;
  noindex?: boolean;
  ogImage?: string;
}

const { title, description, seoTitle, noindex = false, ogImage } = Astro.props;
const pageTitle = `${seoTitle ?? title} | ${business.businessName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagePath = ogImage || business.ogImage;
const image = new URL(imagePath, Astro.site);
const robots = noindex ? 'noindex, nofollow' : 'index, follow';
const ga4 = /^G-[A-Z0-9]+$/.test(business.analytics.ga4) ? business.analytics.ga4 : '';
const gtm = /^GTM-[A-Z0-9]+$/.test(business.analytics.gtm) ? business.analytics.gtm : '';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
<meta name="robots" content={robots} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image.href} />
<meta property="og:image:width" content={String(business.ogImageWidth)} />
<meta property="og:image:height" content={String(business.ogImageHeight)} />
<meta property="og:url" content={canonical.href} />
<meta property="og:type" content="website" />
<meta property="og:locale" content={business.locale} />
<meta property="og:site_name" content={business.businessName} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image.href} />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
{ga4 && (
  <script is:inline define:vars={{ ga4 }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', ga4);
  </script>
)}
{ga4 && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}></script>}
{gtm && (
  <script is:inline define:vars={{ gtm }}>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtm);
  </script>
)}
