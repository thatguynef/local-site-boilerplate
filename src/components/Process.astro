---
import type { Step } from '../lib/schema';
import Section from './primitives/Section.astro';

interface Props {
  steps?: Step[];
  heading?: string;
}
const { steps = [], heading = 'How it works' } = Astro.props;
---

{steps.length > 0 && (
  <Section marker="process" heading={heading}>
    <ol class="steps">
      {steps.map((step) => (
        <li>
          <strong>{step.name}.</strong> {step.text}
        </li>
      ))}
    </ol>
  </Section>
)}
