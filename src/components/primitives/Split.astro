---
const { as: Tag = 'div', gap, columns } = Astro.props;
const className = Astro.props.class;
const style = [
  gap ? `--split-gap: ${gap}` : '',
  columns ? `--split-columns: ${columns}` : '',
].filter(Boolean).join('; ');
---

<Tag class:list={['split', className]} style={style || undefined}>
  <slot />
</Tag>
