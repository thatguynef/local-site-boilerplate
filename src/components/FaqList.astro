---
import type { Faq } from '../lib/schema';
import Section from './primitives/Section.astro';

interface Props {
  faqs?: Faq[];
  heading?: string;
}
const { faqs = [], heading = 'Common questions' } = Astro.props;
---

{faqs.length > 0 && (
  <Section class="faq" marker="faq" heading={heading}>
    {faqs.map((faq) => (
      <article>
        <h3>{faq.q}</h3>
        <p>{faq.a}</p>
      </article>
    ))}
  </Section>
)}
