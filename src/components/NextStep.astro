---
import { business } from '../config/business';
import Cluster from './primitives/Cluster.astro';
import ContactAction from './primitives/ContactAction.astro';
import Section from './primitives/Section.astro';
---

<Section heading="Ready for a visit?">
  <Cluster as="p" class="actions" gap="0.75rem">
    <ContactAction href={`tel:${business.phoneTel}`}>Call {business.phoneDisplay}</ContactAction>
    <ContactAction href="/contact/" tone="secondary">Request a call</ContactAction>
  </Cluster>
</Section>
